+def _validate_run_cwd(cwd: str) -> Optional[str]:
+    """Validate an absolute existing directory for /v1/runs cwd override.
+
+    Rejects relative paths, missing directories, and any ``..`` segment.
+    """
+    raw = str(cwd or "").strip()
+    if not raw:
+        return None
+    try:
+        path = Path(raw).expanduser()
+        if not path.is_absolute():
+            return None
+        if any(part == ".." for part in path.parts):
+            return None
+        resolved = path.resolve(strict=True)
+        if not resolved.is_dir():
+            return None
+        return str(resolved)
+    except (OSError, ValueError):
+        return None
+
+
+def _parse_run_toolsets(body: Dict[str, Any]) -> Optional[List[str]]:
+    """Parse enabled_toolsets / toolsets from a /v1/runs request body."""
+    raw = body.get("enabled_toolsets")
+    if raw is None:
+        raw = body.get("toolsets")
+    if raw is None:
+        return None
+    if isinstance(raw, str):
+        items = [part.strip() for part in raw.split(",") if part.strip()]
+    elif isinstance(raw, list):
+        items = [str(item).strip() for item in raw if str(item).strip()]
+    else:
+        return None
+    return sorted(set(items)) if items else None
+
